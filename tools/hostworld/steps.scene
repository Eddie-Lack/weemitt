# A floor, three steps of 8 units each and a wall of 100 units across the far side. The glove walks into them
# (the test's input pushes the stick forward).
tri -300 0 -300  -300 0 300  300 0 300  0
tri -300 0 -300  300 0 300  300 0 -300  0
# Step 1, its riser and its top.
tri -60 0 60  -60 8 60  60 8 60  0
tri -60 0 60  60 8 60  60 0 60  0
tri -60 8 60  -60 8 300  60 8 300  0
tri -60 8 60  60 8 300  60 8 60  0
# Step 2.
