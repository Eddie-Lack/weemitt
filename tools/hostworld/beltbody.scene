tri -40 -5 -40  40 5 -40  40 -5 -40  0
tri -40 -5 40  40 -5 40  40 5 40  0
tri -40 -5 40  40 5 40  -40 5 40  0
end
move 1 sine 400 0 0 60
move 2 spin 400
bodyconveyor 0 1 0.3 0 0
bodyconveyor 0 2 0.3 0 0
